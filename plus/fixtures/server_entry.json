{
  "enabled": false,
  "id": "fixture-files",
  "name": "Files",
  "transport": "stdio",
  "command": "npx",
  "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
  "hidePrompts": true,
  "requestTimeoutMs": 45000,
  "plus": {
    "authProbe": { "kind": "slack", "tokenKey": "SYNTHETIC_TOKEN" },
    "futurePlusField": 7
  },
  "mcpmSource": { "type": "git", "path": "/synthetic/path", "drift": false },
  "mcpmTags": ["synthetic"],
  "mcpmOauth": true,
  "forwardInstructions": true,
  "declareClientCapabilities": true,
  "maxRequestTimeoutMs": 600000,
  "toolBudgets": { "job_wait": 600, "quick": 1.5 },
  "serial": true,
  "serverMode": "search",
  "fieldFromNewerUpstream": { "nested": [1, 2, 3] }
}
