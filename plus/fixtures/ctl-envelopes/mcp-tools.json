{
  "argv": ["mcp", "tools"],
  "envelope": {
    "command": "mcp",
    "data": {
      "resources": [
        {
          "description": "Canonical, sync and output roots",
          "mimeType": "application/json",
          "name": "paths",
          "uri": "mcpm://paths"
        },
        {
          "description": "Registry summary and drift counts",
          "mimeType": "application/json",
          "name": "status",
          "uri": "mcpm://status"
        },
        {
          "description": "Data-flow diagram",
          "mimeType": "text/markdown",
          "name": "flow",
          "uri": "mcpm://flow"
        },
        {
          "description": "Servers, transport and source",
          "mimeType": "text/plain",
          "name": "inventory-servers",
          "uri": "mcpm://inventory/servers"
        }
      ],
      "server": "toolport-plus-self",
      "tools": [
        {
          "description": "Absolute paths and state of this installation",
          "dryRunDefault": false,
          "gate": "none",
          "name": "where_am_i",
          "params": [],
          "tier": 1
        },
        {
          "description": "Read-only health checks",
          "dryRunDefault": false,
          "gate": "none",
          "name": "doctor",
          "params": [],
          "tier": 1
        },
        {
          "description": "Data-flow diagram of skills and servers",
          "dryRunDefault": false,
          "gate": "none",
          "name": "flow_diagram",
          "params": [],
          "tier": 1
        },
        {
          "description": "List registered servers",
          "dryRunDefault": false,
          "gate": "none",
          "name": "servers_list",
          "params": [
            {
              "description": "Include source information",
              "name": "include_sources",
              "required": false,
              "type": "boolean"
            }
          ],
          "tier": 1
        },
        {
          "description": "Read one server entry without secret values",
          "dryRunDefault": false,
          "gate": "none",
          "name": "servers_get",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            }
          ],
          "tier": 1
        },
        {
          "description": "List access sets (profiles) and the servers each lists",
          "dryRunDefault": false,
          "gate": "none",
          "name": "servers_list_profiles",
          "params": [],
          "tier": 1
        },
        {
          "description": "List a server in an access set, by the set's name or id; a server that is switched off stays unreachable until it is switched on",
          "dryRunDefault": false,
          "gate": "none",
          "name": "servers_add_profile_tag",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "Access set name or id",
              "name": "profile_tag",
              "required": true,
              "type": "string"
            }
          ],
          "tier": 2
        },
        {
          "description": "Take a server out of an access set, by the set's name or id",
          "dryRunDefault": false,
          "gate": "none",
          "name": "servers_remove_profile_tag",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "Access set name or id",
              "name": "profile_tag",
              "required": true,
              "type": "string"
            }
          ],
          "tier": 2
        },
        {
          "description": "Register a new server",
          "dryRunDefault": false,
          "gate": "always",
          "name": "servers_install",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "Server configuration; env is {NAME: value} for plain settings, never a credential; inheritEnv gives the process the whole shell environment",
              "name": "config",
              "required": true,
              "type": "object"
            },
            {
              "description": "Access sets to list it in",
              "name": "profile_tags",
              "required": false,
              "type": "string[]"
            },
            {
              "description": "Replace an existing entry",
              "name": "force",
              "required": false,
              "type": "boolean"
            },
            {
              "description": "Must be true to run this tool",
              "name": "confirm",
              "required": false,
              "type": "boolean"
            }
          ],
          "tier": 3
        },
        {
          "description": "Patch a server's configuration, including plain env entries and inheritEnv",
          "dryRunDefault": false,
          "gate": "always",
          "name": "servers_update_config",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "Fields to change; env is {NAME: value}, null removes a name, a credential is refused",
              "name": "patch",
              "required": true,
              "type": "object"
            },
            {
              "description": "Must be true to run this tool",
              "name": "confirm",
              "required": false,
              "type": "boolean"
            }
          ],
          "tier": 3
        },
        {
          "description": "Change how a server is exposed to clients",
          "dryRunDefault": false,
          "gate": "always",
          "name": "servers_set_mode",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "auto, direct, router, legacy or bridge",
              "name": "mode",
              "required": true,
              "type": "string"
            },
            {
              "description": "Must be true to run this tool",
              "name": "confirm",
              "required": false,
              "type": "boolean"
            }
          ],
          "tier": 3
        },
        {
          "description": "Remove a server and its vault entries",
          "dryRunDefault": false,
          "gate": "always",
          "name": "servers_uninstall",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "Remove client entries too",
              "name": "propagate_to_clients",
              "required": false,
              "type": "boolean"
            },
            {
              "description": "Must be true to run this tool",
              "name": "confirm",
              "required": false,
              "type": "boolean"
            }
          ],
          "tier": 4
        },
        {
          "description": "Restart one server's process in every running gateway so it runs its current code and its tool list is read again; dry_run is on by default (apply with dry_run=false and confirm=true); if_idle=true restarts only when no call is in flight, because a restart ends them",
          "dryRunDefault": true,
          "gate": "unless-dry-run",
          "name": "servers_restart",
          "params": [
            {
              "description": "Server id or name",
              "name": "name",
              "required": true,
              "type": "string"
            },
            {
              "description": "Report without writing; true unless you pass false to apply",
              "name": "dry_run",
              "required": false,
              "type": "boolean"
            },
            {
              "description": "Restart only when no call is in flight",
              "name": "if_idle",
              "required": false,
              "type": "boolean"
            },
            {
              "description": "Must be true to run this tool",
              "name": "confirm",
              "required": false,
              "type": "boolean"
            }
          ],
          "tier": 3
        }
      ]
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
