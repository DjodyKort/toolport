{
  "argv": ["memory", "set", "default", "--cwd", "{home}/proj"],
  "envelope": {
    "command": "memory set",
    "data": {
      "conflicts": [],
      "cwd": "<WORLD>/home/proj",
      "dryRun": false,
      "name": "proj",
      "plan": {
        "effects": {
          "tokens": {
            "after": 54,
            "basis": "estimate",
            "before": 30
          }
        },
        "steps": [
          {
            "detail": "put back 1 key(s) owned by leave-out",
