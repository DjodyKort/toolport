{
  "argv": ["sessions", "clear", "--cwd", "{home}/proj", "--ids", "sess-new"],
  "envelope": {
    "command": "sessions clear",
    "data": {
      "confirm": null,
      "cwd": "<WORLD>/home/proj",
      "dryRun": false,
      "name": "proj",
      "plan": {
        "effects": {},
        "steps": [
          {
            "detail": "1 session(s), 8 bytes, to Toolport's trash; kept 30 days",
            "op": "move",
            "path": "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj"
          }
        ],
        "summary": "Clear 1 session(s) of proj",
        "undo": "toolportctl sessions undo sessions-<STAMP>",
        "warnings": [
          "Sessions are moved, never copied, so --resume <id> still finds each one exactly once",
          "Prompt history, the project entry in ~/.claude.json and per-session task and debug folders are left alone"
        ]
      },
      "result": {
        "applied": true,
        "backups": [],
        "changed": [
          "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-new.jsonl"
        ],
        "id": "sessions-<STAMP>",
        "undo": "toolportctl sessions undo sessions-<STAMP>"
      },
      "root": "<WORLD>/home/proj",
      "sessions": [
        {
          "ageDays": 1,
          "bytes": 8,
          "daysLeft": 29,
          "expiresAt": "<masked>",
          "expiring": false,
          "folder": "<WORLD>/home/proj",
          "id": "sess-new",
          "modified": "<TIME>"
        }
      ],
      "to": "trash",
      "totalBytes": 8
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
