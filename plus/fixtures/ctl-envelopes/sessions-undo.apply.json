            "path": "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-old.jsonl"
          }
        ],
        "summary": "Put back 3 session item(s) of proj",
        "undo": "toolportctl sessions clear --cwd <WORLD>/home/proj",
        "warnings": []
      },
      "result": {
        "applied": true,
        "backups": [],
        "changed": [
          "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-new.jsonl",
          "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-old",
          "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-old.jsonl"
        ],
        "undo": "toolportctl sessions clear --cwd <WORLD>/home/proj"
      },
      "root": "<WORLD>/home/proj"
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
