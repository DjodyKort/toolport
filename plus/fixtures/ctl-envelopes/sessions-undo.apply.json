    "command": "sessions undo",
    "data": {
      "dryRun": false,
      "id": "sessions-<STAMP>",
      "name": "proj",
      "plan": {
        "effects": {},
        "steps": [
          {
            "detail": "move 8 bytes back",
            "op": "move",
            "path": "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-new.jsonl"
          },
          {
            "detail": "move 3 bytes back",
            "op": "move",
            "path": "<WORLD>/home/.claude/projects/<WORLD-SLUG>-home-proj/sess-old"
