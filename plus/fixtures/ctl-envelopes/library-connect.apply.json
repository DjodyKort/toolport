{
  "argv": [
    "library",
    "connect",
    "{base}/lib-remote.git",
    "--clone-to",
    "{home}/lib/ai-skills"
  ],
  "envelope": {
    "command": "library connect",
    "data": {
      "branch": "main",
      "connected": true,
      "dryRun": false,
      "empty": false,
      "remote": "<WORLD>/lib-remote.git",
      "repo": "<WORLD>/home/lib/ai-skills",
      "result": {
        "applied": true,
        "backups": [],
        "changed": ["<WORLD>/home/lib/ai-skills"],
        "undo": "remove the folder <WORLD>/home/lib/ai-skills and the local_path entry of <WORLD>/data/skills_sync.json"
      }
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
