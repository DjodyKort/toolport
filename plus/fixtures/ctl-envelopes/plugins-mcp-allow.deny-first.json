{
  "argv": ["plugins", "mcp", "deny", "ecc@ecc", "chrome", "--cwd", "{home}/proj"],
  "envelope": {
    "command": "plugins mcp deny",
    "data": {
      "changes": [
        {
          "action": "add",
          "key": "deniedMcpServers",
          "value": "plugin:ecc:chrome"
        }
      ],
      "conflicts": [],
      "cwd": "<WORLD>/home/proj",
      "dryRun": false,
      "id": "ecc@ecc",
      "ledger": "<WORLD>/data/plus/profile-ledger.json",
      "plan": {
        "effects": {},
        "steps": [
          {
            "detail": "1 key(s) owned by mcp:ecc@ecc:chrome",
            "diff": {
              "after": "deniedMcpServers: {\"serverName\":\"plugin:ecc:chrome\"}\n",
              "before": "deniedMcpServers: (absent)\n"
            },
            "keys": ["deniedMcpServers"],
            "op": "create",
            "path": "<WORLD>/home/proj/.claude/settings.local.json"
          },
          {
            "detail": "git-ignore .claude/settings.local.json",
            "op": "update",
            "path": "<WORLD>/home/proj/.git/info/exclude"
          },
          {
            "detail": "record every key Toolport owns with the value it replaces, so undo restores exactly that",
            "op": "note",
            "path": "<WORLD>/data/plus/profile-ledger.json"
          },
          {
            "detail": "tools of the server are named mcp__plugin_ecc_chrome__*; the plugin itself stays on",
            "op": "note"
          }
        ],
        "summary": "Deny MCP server chrome of ecc@ecc in <WORLD>/home/proj",
        "undo": "toolportctl plugins mcp allow ecc@ecc chrome --cwd <WORLD>/home/proj",
        "warnings": [
          "the server stays outside the Toolport gateway; this only tells Claude Code not to start it here",
          "Claude Code reads plugin settings when a session starts: sessions that are already running keep the old state until they restart"
        ]
      },
      "result": {
        "applied": true,
        "backups": [],
        "changed": [
          "<WORLD>/home/proj/.claude/settings.local.json",
          "<WORLD>/home/proj/.git/info/exclude"
        ],
        "undo": "toolportctl plugins mcp allow ecc@ecc chrome --cwd <WORLD>/home/proj"
      },
      "scope": "folder",
      "server": "chrome",
      "serverName": "plugin:ecc:chrome",
      "toolPrefix": "mcp__plugin_ecc_chrome__*"
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
