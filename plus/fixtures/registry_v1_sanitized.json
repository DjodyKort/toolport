{
  "version": 1,
  "servers": [
    {
      "id": "srv-git",
      "name": "Synthetic git",
      "transport": "stdio",
      "command": "synthetic-cmd",
      "args": ["--serve"],
      "env": [
        {
          "key": "SYNTHETIC_KEY",
          "value": "synthetic-value",
          "secret": false
        }
      ],
      "source": "imported:mcpm",
      "mcpmSource": {
        "type": "git",
        "path": "/synthetic/path",
        "remote": "origin",
        "branch": "main",
        "drift": false,
        "last_checked": "2026-01-01T00:00:00Z",
        "post_update": "synthetic-post"
      },
      "mcpmTags": ["tag-a", "tag-b"],
      "requestTimeoutMs": 45000,
      "initializeTimeoutMs": 20000,
      "forwardInstructions": true,
      "declareClientCapabilities": true,
      "maxRequestTimeoutMs": 600000,
      "toolBudgets": { "job_wait": 600 },
      "serverMode": "search"
    },
    {
      "id": "srv-npx",
      "name": "Synthetic npx",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@synthetic/package"],
      "env": [],
      "source": "imported:mcpm",
      "mcpmSource": {
        "type": "npx",
        "package": "@synthetic/package"
      },
      "forwardInstructions": true
    },
    {
      "id": "srv-release",
      "name": "Synthetic release",
      "transport": "stdio",
      "command": "synthetic-cmd",
      "args": ["--serve"],
      "env": [],
      "source": "imported:mcpm",
      "mcpmSource": {
        "type": "github-release",
        "path": "/synthetic/bin",
        "repo": "synthetic/repo",
        "current_version": "1.0.0",
        "asset_pattern": "synthetic-*.tar.gz",
        "include_prerelease": false,
        "last_updated": "2026-01-02T00:00:00Z"
      }
    },
    {
      "id": "srv-remote",
      "name": "Synthetic remote",
      "transport": "http",
      "args": [],
      "env": [],
      "source": "catalog:curated",
      "url": "https://example.test/mcp",
      "mcpmOauth": true,
      "mcpmSource": {
        "type": "remote"
      },
      "mcpmTags": []
    },
    {
      "id": "srv-untyped",
      "name": "Synthetic untyped",
      "transport": "stdio",
      "command": "synthetic-cmd",
      "args": ["--serve"],
      "env": [],
      "source": "imported:mcpm",
      "mcpmSource": {
        "last_updated": "2026-01-03T00:00:00Z"
      },
      "mcpmOauth": false,
      "forwardInstructions": false,
      "plus": {
        "authProbe": {
          "kind": "slack",
          "tokenKey": "SYNTHETIC_TOKEN"
        },
        "futurePlusField": 1
      }
    },
    {
      "id": "srv-unknown",
      "name": "Synthetic unknown",
      "transport": "stdio",
      "command": "synthetic-cmd",
      "args": ["--serve"],
      "env": [],
      "source": "imported:mcpm",
      "mcpmSource": {
        "type": "unknown",
        "reason": "synthetic reason"
      }
    },
    {
      "id": "srv-docker",
      "name": "Synthetic docker",
      "transport": "stdio",
      "command": "synthetic-cmd",
      "args": ["--serve"],
      "env": [],
      "source": "imported:mcpm",
      "maxRequestTimeoutMs": 0,
      "mcpmSource": {
        "type": "docker",
        "image": "synthetic/image",
        "tag": "latest",
        "digest": "sha256:synthetic"
      },
      "plus": {
        "authProbe": {
          "kind": "odoo",
          "baseUrl": "https://odoo.example.test",
          "db": "synthetic",
          "uid": "9"
        }
      }
    },
    {
      "id": "srv-orphan",
      "name": "Synthetic orphan",
      "transport": "stdio",
      "command": "synthetic-cmd",
      "args": ["--serve"],
      "env": [
        {
          "key": "SYNTHETIC_KEY",
          "value": "synthetic-value",
          "secret": false
        }
      ],
      "source": "plus:selfmcp"
    }
  ],
  "profiles": [
    {
      "id": "default",
      "name": "Default",
      "enabledServerIds": [
        "srv-git",
