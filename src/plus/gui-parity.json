  "actions": {
    "catalog.commands": {
      "route": "catalog",
      "status": "built",
      "summary": "The registry listing (toolportctl commands): every command with its tier and a search, Run for the read-only ones and Copy for the rest; a form per command arrives with the first command that needs operands",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "catalog.mcp-call": {
      "route": "catalog",
      "status": "built",
      "summary": "Run a self-management tool through mcp call with its arguments as JSON on stdin, a preview when the tool offers one, the tool name typed to confirm for a tool that changes things",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "system.doctor": {
      "route": "system",
      "status": "built",
      "summary": "Installation checks, including whether this build carries the fork seam (doctor)",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "system.mcp-doctor": {
      "route": "system",
      "status": "built",
      "summary": "Check the self-management server and where it is listed (mcp doctor)",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "system.mcp-install": {
      "route": "system",
      "status": "built",
      "summary": "Register the self-management server and list it in an access set (mcp install)",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "system.mcp-tools": {
      "route": "system",
      "status": "built",
      "summary": "List the self-management tools and resources (mcp tools)",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "system.mcp-uninstall": {
      "route": "system",
      "status": "built",
      "summary": "Remove the self-management server and keep it removed (mcp uninstall)",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "system.status": {
      "route": "system",
      "status": "built",
      "summary": "Registry, access sets, secrets backend and gateway state (status)",
      "test": "src/plus/settings/ToolportPlusPage.test.tsx"
    },
    "servers.list": {
      "route": "servers",
      "status": "built",
      "summary": "The servers list: every server with its global switch and the default access (server ls, servers_list); upstream's list stays whole, the fork adds banner rows",
      "test": "src/plus/servers/ServersBanner.test.tsx"
    },
    "servers.detail": {
      "route": "servers",
      "status": "built",
      "summary": "One server's Operations rows: command, plain env keys, access sets and what its process sees of the shell environment (server info, servers_get)",
      "test": "src/plus/servers/ServerOperations.test.tsx"
    },
    "servers.add-catalog": {
      "route": "servers",
      "status": "built",
      "summary": "Add a curated catalog server and finish its setup: secrets, who can reach it (server install)",
      "test": "src/plus/servers/ServersBanner.test.tsx"
    },
    "servers.add": {
      "route": "servers",
      "status": "built",
      "summary": "Add a server from a command or a URL, with plain env and the shell-environment switch, then Finish setup (server new, servers_install)",
      "test": "src/plus/servers/ServersBanner.test.tsx"
    },
    "servers.edit": {
      "route": "servers",
      "status": "built",
      "summary": "Edit a server's command, arguments, URL, plain env and the shell-environment switch through upstream's Edit; the Runtime row explains what the process sees (server edit, servers_update_config)",
      "test": "src/plus/servers/ServerOperations.test.tsx"
    },
    "servers.remove": {
      "route": "servers",
      "status": "built",
      "summary": "Remove a server and its vault entries, with a preview first (server uninstall, servers_uninstall)",
      "test": "src/plus/servers/ServerOperations.test.tsx"
    },
    "servers.restart": {
      "route": "servers",
      "status": "built",
      "summary": "Restart a server in every running gateway: one click when idle, a confirmation naming the calls in flight otherwise, a result per gateway with retry (server restart, servers_restart)",
      "test": "src/plus/servers/RuntimeRow.test.tsx"
    },
    "servers.access-sets": {
      "route": "servers",
      "status": "built",
      "summary": "Servers by access set in one table (servers_list_profiles)",
      "test": "src/plus/servers/AccessCompare.test.tsx"
    },
    "servers.access-set-member": {
      "route": "servers",
      "status": "built",
      "summary": "List a server in an access set or take it out: a table cell with Undo, the Finish setup chips, the Reach row (servers_add_profile_tag, servers_remove_profile_tag)",
      "test": "src/plus/servers/AccessCompare.test.tsx"
    },
    "servers.advanced-mode": {
      "route": "servers",
      "status": "planned",
      "summary": "Per server, whether its tools are listed to clients that get the full tool list (auto) or only found through toolport_search_tools and called by name (search), in the Advanced disclosure; the screen row comes later (server mode, servers_set_mode)"
    },
    "servers.secret-set": {
      "route": "servers",
      "status": "built",
      "summary": "Set or replace a secret a server declares through a write-only field in the Secrets row; the value goes to stdin only, a placeholder is refused, and a server with a login check can be checked right after saving (secret set). A remote server's access token stays in upstream's Secrets dialog",
      "test": "src/plus/servers/SecretsRow.test.tsx"
    },
    "servers.secret-reveal": {
      "route": "servers",
      "status": "built",
      "summary": "Say which declared keys of a server are set, and reveal one after a confirmation; the value hides after 10 seconds, when the window loses focus, and is never shown for the access token or asked through the self-MCP (secret get)",
      "test": "src/plus/servers/SecretsRow.test.tsx"
    },
    "servers.secret-remove": {
      "route": "servers",
      "status": "built",
      "summary": "Remove a secret and its declaration after a preview of what goes; the key is typed when the policy tier of secret rm is destructive (secret rm)",
      "test": "src/plus/servers/SecretsRow.test.tsx"
    },
    "servers.login": {
      "route": "servers",
      "status": "built",
      "summary": "Sign in again from the Login row of a stdio or Google server through its own auth command, with the consent link shown while the browser sign-in runs; remote servers keep upstream's Sign in button (auth login, servers_auth)",
      "test": "src/plus/servers/LoginRow.test.tsx"
    },
    "servers.login-check": {
      "route": "servers",
      "status": "built",
      "summary": "The Login row of a stdio or Google server: the state, its reason, when it was last checked and Check now; the list banner names the servers whose check failed; remote servers have no Login row (auth probe, status)",
      "test": "src/plus/servers/LoginRow.test.tsx"
    },
    "servers.login-summary": {
      "route": "servers",
      "status": "planned",
      "summary": "The login summary line for a statusline or a session hook, counting stdio and Google logins only; no client is wired to it (auth statusline, auth hook)"
    },
    "context.bundles": {
      "route": "context",
      "status": "planned",
      "summary": "Folder bundles: list, show, create (from a folder too), edit and delete a bundle definition (context bundle ls|show|add|edit|rm, context_bundle_ls)"
    },
    "context.bundle-apply": {
      "route": "context",
      "status": "planned",
      "summary": "Apply a bundle to a folder after its plan, drift per key, undo, copy the launch command and the auto-apply switch (context bundle apply|undo|status|launch|config, context_bundle_apply|undo|status)"
    },
    "context.use": {
      "route": "context",
      "status": "planned",
      "summary": "Apply a bundle and route the folder to its access set, or drop both (context use); planned and not ported: the 1.x switch that turns folder routing off (context folders --enable|--disable), because upstream always routes; removing it waits for the owner's decision"
    },
    "context.leave-out": {
      "route": "context",
      "status": "planned",
      "summary": "Leave a CLAUDE.md or rule out of a folder, or turn auto memory off, one click with Undo (context leave-out, context_leave_out)"
    },
    "context.folder": {
      "route": "context",
      "status": "planned",
      "summary": "This folder: what loads with the estimate, the composed text and the leave-out switches (context loads|compose, context_loads, context_compose)"
    },
    "context.sync": {
      "route": "context",
      "status": "planned",
      "summary": "Sync now on Rules and launch: bound bundles and, later, the layers deploy (context sync)"
    },
    "context.measure": {
      "route": "context",
      "status": "planned",
      "summary": "Measure for real: confirmation first, the measured total with the not-itemised part, stale and cached states (context measure, context_measure); also without a plugin or skill or with a bundle, one request per variant with its delta, the rows its InstructionsLoaded log confirms (context loads --measured), and the folder's calibration factor next to the estimates"
    },
    "context.plugin-switch": {
      "route": "context",
      "status": "planned",
      "summary": "Turn a plugin off or back on in one folder, one click with Undo, on the leave-out ledger (plugins off|on); a bundle's plugins.config is applied again as env keys"
    },
    "context.status": {
      "route": "context",
      "status": "planned",
      "summary": "The This folder tab's read-only summary: applied bundle, leave-outs, plugin switches, the estimate, the last measurement with its calibration factor (context status, context_status)"
    },
    "library.sync": {
      "route": "library",
      "status": "planned",
      "summary": "The Sync tab: plan with held removals, hooks and differing files, Apply, verification line (skills sync, status, diff, clean; skills_sync, skills_status, skills_diff, skills_clean)"
    },
    "library.checks": {
      "route": "library",
      "status": "planned",
      "summary": "The Checks list: lint, skipped files, dead links, audit and shadowing files (skills lint, audit, resolve; skills_lint, skills_audit, skills_resolve)"
    },
    "library.items": {
      "route": "library",
      "status": "planned",
      "summary": "The library items and skill detail with its files (skills ls, skills_list, skills_get, skills_list_transpilers)"
    },
    "library.new": {
      "route": "library",
      "status": "planned",
      "summary": "New skill, rule or library (skills add, init; skills_scaffold)"
    },
    "library.uninstall": {
      "route": "library",
      "status": "planned",
      "summary": "Delete a skill from the library with its installed files (skills uninstall; skills_uninstall)"
    },
    "library.bundle": {
      "route": "library",
      "status": "planned",
      "summary": "Pack skills into a portable zip or extract one into the library (skills bundle, unbundle; skills_bundle, skills_unbundle)"
    },
    "library.taps": {
      "route": "library",
      "status": "planned",
      "summary": "Taps: add, list, update and remove git sources of skills, search them and install a skill with its audit (skills tap add|ls|remove|update, search, install; skills_tap_list, skills_tap_add, skills_tap_remove, skills_tap_update, skills_search, skills_install)"
    },
    "library.remote": {
      "route": "library",
      "status": "planned",
      "summary": "The library against its remote: status, pull and review the plan, push after the audit and the secret scan (library status|pull|push; library_status, library_pull, skills_git_push)"
    }
  },
