exit 2
--- stdout
toolportctl: manage Toolport+ from the command line

Usage: toolportctl [--json] [--data-dir <dir>] <command> [args]

Commands:
  status         Show registry, profile, secrets backend and gateway state
  doctor         Run read-only health checks
  commands       List all commands with tier, dry-run support and flags (the registry)
  server ls      List servers and whether the active profile enables them
  server search  Search the catalog (--offline, --limit <n>)
  server install Install a catalog server by name
  server uninstall Remove a server and its client entries (--dry-run)
  server info    Show one server's definition and profiles
  server new     Add a custom server (--command or --url)
  server edit    Edit a server's name, command, args, url or cwd
  inspect        List the tools a server exposes (connects live)
  profile inspect List the tools of every server in a profile (connects live)
  profile ls     List profiles and their servers (--verbose)
  profile create Create an empty profile (<name>, --force, --dry-run)
  profile edit   Rename a profile or change its servers (--name, --servers, --add-server, --remove-server, --dry-run)
  profile rm     Delete a profile and clean the client entries scoped to it (--no-clients, --dry-run)
  profile        Profiles: ls create edit rm inspect
  client ls      List detected clients and their direct entries
  client sync    Sync managed clients (--client <id>, --dry-run, --keep-orphans)
  client edit    Point a client at a profile (<client>, --add-profile, --remove-profile, --set-profiles, --force, --dry-run)
  client import  Import a client's direct entries into the registry (<client>, --select, --all, --profile, --dry-run)
  client direct add Give a client one server as its own direct entry (<server>, --client <id>, --force, --dry-run)
  client direct rm Remove a direct entry Toolport wrote (<server>, --client <id>, --force, --dry-run)
  client direct ls List the direct launcher entries and their state (--client <id>)
  client direct  Direct entries: add rm ls
  client         Client configs: ls edit import sync direct
  direct run     Start a server over stdio for a direct client entry (<server id>)
  direct         Direct launchers: run
  server         Manage servers (mutations) (not implemented)
  auth statusline Compact auth-health JSON for a Claude Code statusline
  auth hook      Auth-health JSON for a Claude Code SessionStart hook
  auth probe     Probe login health now (--server <id>, --force)
  auth login     Sign in to a server again (<server>, --no-open)
  auth           Auth health: statusline hook probe login
  secret set     Store a secret read from stdin or --value-env
  secret get     Check a secret (--reveal prints the value)
  secret rm      Remove a secret
  secret         Manage server secrets (not implemented)
  context loads  Show what a claude session loads, with token cost (--profile, --cwd, --no-lazy, --measured)
  context measure Measure what a folder really loads, in tokens, with Claude Code (--cwd, --without, --bundle, --model, --force, --yes)
  context folders Show the active profile per folder (--cwd, --enable, --disable)
  context checkpoint-status Report used tokens vs the checkpoint point from statusline JSON on stdin
  context plan   Preview the context deploy (--home <dir>, --rules)
  context apply  Apply the context deploy (--home <dir>, --rules, --no-persist, --dry-run)
  context sync   Plan then apply the context deploy (--home <dir>, --rules, --dry-run)
  context init   Scaffold the personal layer and save context.json (--home <dir>, --dry-run, --yes)
  context status Show layers, profiles, legacy MCP duplicates and the shims file (--home <dir>)
  context client add Scaffold a client layer (<name>, --glob <pattern>, --scope, --folder, --import, --delivery, --home <dir>, --dry-run)
  context client edit Change a layer's glob, scope, folders, imports or delivery (<name>, same flags as add, --dry-run)
  context client rm Delete a client layer and the CLAUDE.local.md it was delivered into (<name>, --home <dir>, --dry-run)
  context client list List the context layers with scope, imports, delivery and where each is deployed (--home <dir>)
  context client Client layers: add edit rm list
  context compose Show the instruction text Claude gets in a folder, part by part in load order (--cwd)
  context profile add Define a launch profile and generate it (<name>, --no-org, --rules, --servers, --dry-run)
  context profile list List the configured launch profiles (--home <dir>)
  context profile remove Drop a launch profile; --purge deletes its directory (<name>, --purge, --dry-run)
  context profile Launch profiles: add list remove
  context bundle ls List the context bundles with where each is applied
  context bundle show Show one bundle's definition and lint (<name>)
  context bundle add Write a new bundle (<name>, --from-folder, --description, --skills-off, --skills-name-only, --skills-allow, --plugins-off, --layers-add, --layers-exclude, --agents-off, --servers, --bind, --dry-run)
  context bundle edit Change a bundle; each given list replaces that list (<name>, same flags as add, --dry-run)
  context bundle rm Delete a bundle definition; refuses while applied unless --force (<name>, --force, --dry-run)
  context bundle apply Apply a bundle in the folder where Claude starts, through git-ignored local files (<name>, --cwd, --dry-run)
  context bundle undo Undo the applied bundle in a folder; keys changed since are left alone (--cwd, --dry-run)
  context bundle status Show the bundle applied in a folder and any drift (--cwd)
  context bundle launch Write the --settings file of a bundle and print the claude command (<name>, --cwd)
  context bundle config Show or set whether context sync applies bound bundles (--auto-apply on|off)
  context bundle Context bundles: ls show add edit rm apply undo status launch config
  context use    Apply a bundle and its paired server set to a folder, or drop both (<name>, --none, --cwd, --dry-run)
  context disable Remove the generated shims; --purge-profiles also the profile directories (--dry-run)
  context        Context: init status client profile bundle use compose disable loads checkpoint-status plan apply sync
  compression status Show the compression policy, pin and drift
  compression presets List presets (--refresh re-snapshots knobs, --dry-run)
  compression enable Enable a provider (--provider, --port, --telemetry, --preset, --mode, --dry-run)
  compression disable Disable compression (--teardown, --dry-run)
  compression set-provider Swap the active provider and re-apply (--dry-run)
  compression use Switch the active preset and re-apply (--dry-run)
  compression sync Re-apply the policy: shims, env snippet, MCP entry (--mcpm-root, --dry-run)
  compression pin Show or set the exact engine pin (--install, --refresh, --dry-run)
  compression seal Declare the live proxy posture as policy (--apply, --dry-run)
  compression env Print the proxy env for a directory, for eval (--cwd)
  compression doctor Run the compression health checks
  compression run Launch claude under the directory's policy (--plan to preview)
  compression verify Check provider health, pin, shims and measure cache behaviour
  compression ledger Launch and token-savings ledger (summary | record)
  compression proxy Proxy lifecycle: up, down, restart
  compression update Move the engine pin (--to V | --latest, --accept to apply)
  compression    Compression: status presets enable disable set-provider use sync pin seal env doctor run verify ledger proxy update
  import mcpm    Import an mcpm config root (--dry-run prints the plan)
  import rename-refs Rewrite mcp__mcpm_ tool references under --paths (--tools F, --dry-run)
  import         Import data from other tools (not implemented)
  council        Council server: install uninstall doctor tools
  mcp            Self-management server: install [--profile <id>] uninstall doctor tools call <tool> [--args <json> | --args-stdin]
  sources ls     List where skills, commands, agents, rules and CLAUDE.md come from (--source, --kind, --items, --cwd, --root, --deep, --refresh)
  sources root ls List the folders searched for repo checkouts
  sources root add Search a folder for repo checkouts (<dir>, --dry-run)
  sources root rm Stop searching a folder (<dir>, --dry-run)
  sources root   Search folders: ls add rm
  sources        Sources: ls root
  plugins ls     List installed Claude Code plugins with what each brings and costs (--cwd, --refresh)
  plugins show   Show one plugin: components, hooks, MCP servers, options (<id>, --cwd)
  plugins config Set or unset a plugin's own switches: env keys in a folder, plugin options without one (<id>, --cwd, --set <knob>=<value>, --unset <knob>, --dry-run)
  plugins mcp    Deny or allow a plugin's MCP server in a folder (deny|allow <id> <server>, --cwd, --dry-run)
  plugins        Plugins: ls show config mcp
  hooks ls       List every hook Claude Code would start in a folder, from files (--cwd, --tool, --event, --owner)
  hooks          Hooks: ls
  skills sync    Transpile skills to client outputs (--repo, --home, --client, --project, --dry-run)
  skills ls      List skills and rules (--repo <dir>, --home <dir>, --source <id>)
  skills lint    Lint skills; exits 1 on errors (--repo, --home, --name <skill>)
  skills diff    Compare skills with the lockfile; exits 1 on changes (--repo, --home)
  skills init    Create a skills repository (--path <dir>, --name <name>, --dry-run)
  skills add     Create a skill or rule from a template (<name>, --type, --path, --with-progressive, --dry-run)
  skills audit   Scan skills for prompt injection and risky commands; exits 1 on high findings (--path <dir>)
  skills bundle  Pack skills into a portable zip (--output <zip>, --path <dir>, --skills <a,b>, --dry-run)
  skills unbundle Extract a skills bundle (<bundle.zip>, --path <dir>, --dry-run)
  skills status  Show whether synced outputs still exist; --strict exits 1 on drift (--repo, --home, --client <key>)
  skills clean   Remove synced outputs and the lockfile (--repo, --home, --client <key>, --project, --dry-run)
  skills uninstall Remove a skill, its outputs and its lock entry (<name>, --repo, --home, --project, --dry-run)
  skills resolve Find files shadowing synced skills; --migrate backs them up (--repo, --home, --client <key>, --project, --dry-run)
  skills tap add Register and clone a tap (<user/repo|url>, --name <alias>, --dry-run)
  skills tap ls  List the registered taps
  skills tap remove Unregister a tap and delete its clone (<name>, --dry-run)
  skills tap update Pull one or all taps; exits 1 if one fails (<name>, --dry-run)
  skills tap     Taps: add ls remove update
  skills search  Search the taps for skills by name, description or tags (<query>)
  skills install Install skills from a tap; a high-severity audit finding blocks it (<@user/repo[/skill]>, --path, --no-audit, --dry-run)
  skills         Skills: init add ls lint audit bundle unbundle sync diff status clean uninstall resolve tap search install
  agents add     Create an agent from a template (<name>, --path, --dry-run)
  agents ls      List agents (--path <dir>)
  agents lint    Lint agents; exits 1 on errors (--path <dir>)
  agents audit   Scan agents for prompt injection and risky commands; exits 1 on high findings (--path <dir>)
  agents diff    Show new, modified and removed agents since the last sync (--path <dir>)
  agents status  Show whether synced agent outputs still exist; --strict exits 1 on drift (--path, --home)
  agents clean   Remove synced agent outputs, keeping the lockfile (--path, --home, --client <key>, --project, --dry-run)
  agents uninstall Remove an agent, its outputs and its lock entry (<name>, --path, --home, --project, --dry-run)
  agents sync    Transpile agents to client outputs (--path, --home, --client <key>, --project, --dry-run)
  agents         Agents: add ls lint audit diff status clean uninstall sync
  styles add     Create an output style from a template (<name>, --path, --dry-run)
  styles ls      List output styles and where they are synced (--path <dir>)
  styles lint    Lint output styles; exits 1 on errors (--path <dir>)
  styles diff    Show new, modified and removed styles since the last sync (--path <dir>)
  styles status  Show the synced and the active styles per client (--path <dir>)
  styles sync    Write every style to the native-toggle clients (--path, --home, --client <key>, --project, --dry-run)
  styles apply   Apply one style as an always-on rule to the other clients (<name>, --path, --home, --client <key>, --project, --dry-run)
  styles remove  Remove the active style from the other clients (--path, --home, --client <key>, --project, --dry-run)
  styles clean   Remove every synced and applied style file (--path, --home, --project, --dry-run)
  styles         Styles: add ls lint diff status sync apply remove clean
  sync           Encrypted sync: init push pull diff status reset ...
  cc             Claude Code plugins: list | update [--dry-run]
  update         Check or apply server updates (--check, --apply, --init, --dry-run)
  usage          Token and MCP usage from Claude Code transcripts (--root <dir>, --no-refresh)
  obs otel enable Send Claude Code telemetry to the local receiver (--port <n>, --home <dir>, --dry-run)
  obs otel disable Stop the receiver and remove the telemetry keys Toolport wrote (--home <dir>, --dry-run)
  obs otel status Show the receiver, the Claude settings and the stored OTel events (--home <dir>)
  obs otel       OTel receiver: enable disable status
  obs            Observability: otel enable|disable|status

Options:
  --json             Machine-readable envelope on stdout
  --data-dir <dir>   Override the data directory (default: TOOLPORT_DATA_DIR)
  -h, --help         Show this help
  -V, --version      Show the version

Exit codes: 0 ok, 1 error, 2 usage
