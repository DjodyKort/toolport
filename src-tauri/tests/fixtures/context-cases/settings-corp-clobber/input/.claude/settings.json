{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Read(*)",
      "Bash(ls:*)",
      "mcp__mcpm_examplecorp-odoo__search"
    ],
    "ask": [
      "Bash(rm:*)"
    ],
    "deny": [
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "MY_ENV": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo personal"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo status"
  }
}
