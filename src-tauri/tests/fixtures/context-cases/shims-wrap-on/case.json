{
  "area": "context",
  "entry": "context_scenario",
  "args": {
    "steps": [
      {
        "op": "apply",
        "label": "apply1.report",
        "config": {
          "wrap_default_claude": true,
          "dedupe": {
            "enabled": false
          },
          "clients_root": "{HOME}/clients",
          "profiles": {
            "work": {
              "org_mode": "import",
              "rules": "inherit",
              "servers": "inherit"
            },
            "bare": {
              "org": false,
              "rules": "none",
              "commands": false,
              "skills": false,
              "agents": false,
              "servers": "none",
              "copy_auth": false
            }
          }
        }
      },
      {
        "op": "zsh_syntax",
        "path": ".config/mcpm/context-shims.zsh",
        "label": "context-shims"
      },
      {
        "op": "shim_snippet",
        "label": "snippet.wrap-on.no-profiles",
        "wrap_default": true
      },
      {
        "op": "shim_snippet",
        "label": "snippet.wrap-on.profiles",
        "wrap_default": true,
        "profiles": {
          "work": {
            "org_mode": "import",
            "rules": "inherit",
            "servers": "inherit"
          },
          "bare": {
            "org": false,
            "rules": "none",
            "commands": false,
            "skills": false,
            "agents": false,
            "servers": "none",
            "copy_auth": false
          }
        }
      },
      {
        "op": "apply",
        "label": "apply2-wrap-only.report",
        "config": {
          "wrap_default_claude": true,
          "dedupe": {
            "enabled": false
          },
          "clients_root": "{HOME}/clients"
        }
      },
      {
        "op": "snapshot_file",
        "src": ".config/mcpm/context-shims.zsh",
        "label": "shims.wrap-only.zsh"
      }
    ]
  },
  "comparison": "A",
  "normalizers": [
    "lf",
    "root_paths",
    "lock_fields"
  ],
  "env": {
    "MCPM_CONFIG_DIR": "{HOME}/.config/mcpm",
    "MCPM_CONTEXT_CLAUDE_HOME": "{HOME}/.claude",
    "MCPM_CONTEXT_CLAUDE_JSON": "{HOME}/.claude.json",
    "MCPM_CONTEXT_CACHE_DIR": "{HOME}/.cache/mcpm/context",
    "MCPM_CONTEXT_CF_DIR": "{HOME}/.local/share/corp-dev-tools"
  },
  "exclude": [
    ".cache/*",
    ".git/*",
    "*/.git/*"
  ],
  "overrides": {
    "*.json": "B",
    "*/.mcpm-context-state.json": "B",
    "*.report": "B"
  }
}
