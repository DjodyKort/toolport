{
  "area": "context",
  "entry": "context_scenario",
  "args": {
    "steps": [
      {
        "op": "scaffold_personal"
      },
      {
        "op": "scaffold_client",
        "name": "acme"
      },
      {
        "op": "scaffold_client",
        "name": "v18_arp",
        "glob": "**/clients/v18_arp/**, **/worktrees/v18_arp/**"
      },
      {
        "op": "write_file",
        "path": ".config/mcpm/skills_repo/rules/personal/SKILL.md",
        "content": "---\nname: personal\ndescription: \"Personal always-on layer on top of the org CLAUDE.md\"\nactivation: always\n---\n\n## Personal preferences\n\nEdited body that a rescaffold must not overwrite.\n"
      },
      {
        "op": "scaffold_personal"
      },
      {
        "op": "scaffold_client",
        "name": "acme"
      },
      {
        "op": "skills_global"
      },
      {
        "op": "apply",
        "label": "apply.report",
        "config": {
          "wrap_default_claude": false,
          "dedupe": {
            "enabled": false
          },
          "clients_root": "{HOME}/clients"
        }
      },
      {
        "op": "snapshot_file",
        "src": ".claude/rules/personal.md",
        "label": "personal.rule.md"
      }
    ],
    "notes_label": "scaffold.json"
  },
  "comparison": "A",
  "normalizers": [
    "lf",
    "root_paths",
    "lock_fields"
  ],
  "env": {
    "MCPM_CONFIG_DIR": "{HOME}/.config/mcpm",
    "MCPM_CONTEXT_CLAUDE_HOME": "{HOME}/.claude",
    "MCPM_CONTEXT_CLAUDE_JSON": "{HOME}/.claude.json",
    "MCPM_CONTEXT_CACHE_DIR": "{HOME}/.cache/mcpm/context",
    "MCPM_CONTEXT_CF_DIR": "{HOME}/.local/share/corp-dev-tools"
  },
  "exclude": [
    ".cache/*",
    ".git/*",
    "*/.git/*"
  ],
  "overrides": {
    "*.lock": "B",
    "*settings.json": "B",
    "*.json": "B"
  }
}
