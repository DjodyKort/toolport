{
  "area": "context",
  "entry": "context_scenario",
  "args": {
    "steps": [
      {
        "op": "apply",
        "label": "apply1.report",
        "config": {
          "wrap_default_claude": false,
          "dedupe": {
            "enabled": false
          },
          "clients_root": "{HOME}/clients",
          "profiles": {
            "inh": {
              "org_mode": "import",
              "rules": "inherit"
            },
            "cp": {
              "org_mode": "copy",
              "rules": [
                "personal",
                "client-acme",
                "missing-layer"
              ],
              "link_rules": false,
              "servers": [
                "nope-not-registered"
              ],
              "settings_overrides": {
                "permissions": {
                  "allow": [
                    "Bash(echo:*)"
                  ]
                },
                "model": "haiku"
              }
            },
            "lnk": {
              "org": false,
              "rules": [
                "personal"
              ],
              "servers": "none",
              "copy_auth": false,
              "agents": false
            }
          }
        }
      },
      {
        "op": "links",
        "root": ".config/mcpm/claude-profiles",
        "label": "links"
      },
      {
        "op": "write_file",
        "path": ".claude/rules/client-acme.md",
        "content": "acme\n"
      },
      {
        "op": "write_file",
        "path": ".claude/rules/other.md",
        "content": "other\n"
      },
      {
        "op": "remove",
        "path": ".config/mcpm/claude-profiles/cp/rules/personal.md"
      },
      {
        "op": "apply",
        "label": "apply2.report",
        "config": {
          "wrap_default_claude": false,
          "dedupe": {
            "enabled": false
          },
          "clients_root": "{HOME}/clients",
          "profiles": {
            "cp": {
              "org_mode": "copy",
              "rules": [
                "client-acme"
              ],
              "link_rules": false,
              "servers": "inherit"
            },
            "inh": {
              "rules": "none"
            }
          }
        }
      },
      {
        "op": "links",
        "root": ".config/mcpm/claude-profiles",
        "label": "links2"
      },
      {
        "op": "doctor",
        "label": "doctor"
      }
    ]
  },
  "comparison": "A",
  "normalizers": [
    "lf",
    "root_paths",
    "lock_fields"
  ],
  "env": {
    "MCPM_CONFIG_DIR": "{HOME}/.config/mcpm",
    "MCPM_CONTEXT_CLAUDE_HOME": "{HOME}/.claude",
    "MCPM_CONTEXT_CLAUDE_JSON": "{HOME}/.claude.json",
    "MCPM_CONTEXT_CACHE_DIR": "{HOME}/.cache/mcpm/context",
    "MCPM_CONTEXT_CF_DIR": "{HOME}/.local/share/cf-dev-tools"
  },
  "exclude": [
    ".cache/*",
    ".git/*",
    "*/.git/*",
    ".config/mcpm/auth.json",
    ".config/mcpm/config.json"
  ],
  "overrides": {
    "*.json": "B",
    "*/.mcpm-context-state.json": "B",
    "*.report": "B"
  }
}
