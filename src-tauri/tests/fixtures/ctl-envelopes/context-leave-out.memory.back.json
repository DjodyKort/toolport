{
  "argv": [
    "context",
    "leave-out",
    "rm",
    "--memory",
    "--cwd",
    "{home}/work/erp/clients/acme-erp"
  ],
  "envelope": {
    "command": "context leave-out",
    "data": {
      "cwd": "<WORLD>/home/work/erp/clients/acme-erp",
      "dryRun": false,
      "id": "leave-out",
      "leftOut": [],
      "memoryOff": false,
      "plan": {
        "effects": {},
        "steps": [
          {
            "detail": "put back 1 key(s) owned by leave-out",
            "keys": ["autoMemoryEnabled"],
            "op": "delete",
            "path": "<WORLD>/home/work/erp/clients/acme-erp/.claude/settings.local.json"
          },
          {
            "detail": "drop the record of leave-out in this folder",
            "op": "note",
            "path": "<WORLD>/data/plus/profile-ledger.json"
          }
        ],
        "summary": "Turn auto memory back on in <WORLD>/home/work/erp/clients/acme-erp",
        "undo": "toolportctl context leave-out add --memory --cwd <WORLD>/home/work/erp/clients/acme-erp",
        "warnings": [
          "Open sessions keep what they loaded; the change applies from the next session"
        ]
      },
      "result": {
        "applied": true,
        "backups": [],
        "changed": [
          "<WORLD>/home/work/erp/clients/acme-erp/.claude/settings.local.json",
          "<WORLD>/home/work/erp/clients/acme-erp/.git/info/exclude"
        ],
        "undo": "toolportctl context leave-out add --memory --cwd <WORLD>/home/work/erp/clients/acme-erp"
      },
      "scope": "folder"
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
