{
  "argv": [
    "plugins",
    "config",
    "ecc@ecc",
    "--cwd",
    "{home}/work/acme-erp",
    "--unset",
    "gateguard",
    "--unset",
    "hook_profile",
    "--unset",
    "gateguard_exempt_globs"
  ],
  "envelope": {
    "command": "plugins config",
    "data": {
      "adapter": "ecc@ecc",
      "changes": [
        {
          "action": "unset",
          "env": "ECC_GATEGUARD",
          "knob": "gateguard",
          "value": null
        },
        {
          "action": "unset",
          "env": "ECC_HOOK_PROFILE",
          "knob": "hook_profile",
          "value": null
        },
        {
          "action": "unset",
          "env": "GATEGUARD_EXEMPT_GLOBS",
          "knob": "gateguard_exempt_globs",
          "value": null
        }
      ],
      "conflicts": [],
      "cwd": "<WORLD>/home/work/acme-erp",
      "dryRun": false,
      "id": "ecc@ecc",
      "ledger": "<WORLD>/data/plus/profile-ledger.json",
      "plan": {
        "effects": {},
        "steps": [
          {
            "detail": "put back 3 key(s) owned by config:ecc@ecc",
            "keys": ["env"],
            "op": "delete",
            "path": "<WORLD>/home/work/acme-erp/.claude/settings.local.json"
          },
          {
            "detail": "drop the record of config:ecc@ecc in this folder",
            "op": "note",
            "path": "<WORLD>/data/plus/profile-ledger.json"
          }
        ],
        "summary": "Set 3 knob(s) of ecc@ecc in <WORLD>/home/work/acme-erp",
        "undo": "toolportctl plugins config ecc@ecc --cwd <WORLD>/home/work/acme-erp --set gateguard=off --set hook_profile=minimal --set gateguard_exempt_globs=docs/**,scripts/*.sh",
        "warnings": [
          "A switched-off hook still starts a process and exits at once; only turning the plugin off removes it"
        ]
      },
      "result": {
        "applied": true,
        "backups": [],
        "changed": [
          "<WORLD>/home/work/acme-erp/.claude/settings.local.json",
          "<WORLD>/home/work/acme-erp/.git/info/exclude"
        ],
        "undo": "toolportctl plugins config ecc@ecc --cwd <WORLD>/home/work/acme-erp --set gateguard=off --set hook_profile=minimal --set gateguard_exempt_globs=docs/**,scripts/*.sh"
      },
      "scope": "folder"
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
