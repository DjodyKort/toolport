{
  "argv": ["skills", "uninstall", "demo", "--repo", "{repo}"],
  "envelope": {
    "command": "skills uninstall",
    "data": {
      "dryRun": false,
      "lockDir": "<WORLD>/data",
      "lockUpdated": true,
      "name": "demo",
      "outputRoot": "<WORLD>/home",
      "outputs": ["<WORLD>/home/.claude/skills/demo/SKILL.md"],
      "repo": "<WORLD>/skills-repo",
      "scope": "global",
      "sourcePath": "<WORLD>/skills-repo/skills/demo"
    },
    "ok": true,
    "schemaVersion": 1
  },
  "exitCode": 0
}
