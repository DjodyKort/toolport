{
  "argv": ["skills", "diff", "--repo", "{repo}"],
  "envelope": {
    "command": "skills diff",
    "data": {
      "clean": false,
      "modified": [],
      "new": ["demo"],
      "noLockfile": true,
      "removed": [],
      "repo": "<WORLD>/skills-repo",
      "unchanged": 0
    },
    "error": {
      "code": "unhealthy",
      "message": "one or more checks failed"
    },
    "ok": false,
    "schemaVersion": 1
  },
  "exitCode": 1
}
