{
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "pluginConfigs": {
    "ecc@ecc": {
      "options": {
        "hooks_enabled": true,
        "hook_profile": "strict"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh pre",
            "timeout": 5
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/iterm2-status.sh pre",
            "timeout": 5
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/gh-write-gate.sh",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "TOOLPORT_FIXTURE_MODE=quiet rtk hook claude",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/read-once.sh",
            "timeout": 5
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/format-guard.sh",
            "timeout": 10
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh post",
            "timeout": 5
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/iterm2-status.sh post",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh start"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/handoff-load.sh"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/iterm2-status.sh start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/skills/handoff-notes/hooks/session-notes.sh"
          }
        ],
        "matcher": "startup"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh prompt"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/iterm2-status.sh prompt"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/prompt-lint.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/handoff-save.sh"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh stop"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/iterm2-status.sh stop"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/handoff-checkpoint.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh subagent"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/switchboard-hook.sh end"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/handoff-close.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/iterm2-status.sh notify"
          },
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/desktop-notify.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/permission-log.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/failure-log.sh"
          }
        ]
      }
    ]
  }
}
