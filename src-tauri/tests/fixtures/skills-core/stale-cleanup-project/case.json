{
  "area": "skills",
  "entry": "skills_sync",
  "args": {
    "repo": "repo",
    "clients": [
      "claude-code",
      "cursor",
      "gemini-cli"
    ],
    "then_remove": [
      "repo/skills/code-review",
      "repo/rules/python-style"
    ]
  },
  "comparison": "A",
  "normalizers": [
    "lf",
    "root_paths",
    "lock_fields"
  ],
  "overrides": {
    "*mcpm-skills.lock": "B"
  },
  "input_from": "_shared/skills-basic",
  "exclude": [
    "repo/skills/*",
    "repo/rules/*"
  ]
}
