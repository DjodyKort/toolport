    "PreCompact": [
      {
        "hooks": [
          {
            "command": "<HOME>/.claude/skills/handoff-notes/scripts/precompact.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
