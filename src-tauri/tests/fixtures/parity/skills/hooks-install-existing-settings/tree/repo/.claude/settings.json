{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/user-hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "<HOME>/repo/.claude/skills/handoff-notes/scripts/precompact.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "<HOME>/repo/.claude/skills/handoff-notes/scripts/session-end.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "<HOME>/repo/.claude/skills/handoff-notes/scripts/session-start.sh",
            "type": "command"
          }
        ],
        "matcher": "startup"
      }
    ]
  },
  "theme": "dark"
}
