{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "MY_ENV": "1",
    "TEAM_ENV": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo personal",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "mcp__examplecorp-odoo__*",
      "Read(*)",
      "Bash(git diff:*)",
      "WebFetch(domain:example.test)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "mcp__mcpm_examplecorp-odoo__search"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(curl:*)"
    ]
  },
  "statusLine": {
    "command": "echo status",
    "type": "command"
  }
}
