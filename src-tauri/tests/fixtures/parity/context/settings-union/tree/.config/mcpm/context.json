{
  "cf_wrapper_hash": null,
  "clients_root": "<HOME>/clients",
  "dedupe": {
    "enabled": false,
    "legacy_names": [
      "context7",
      "playwright",
      "codeforward-odoo",
      "codeforward-typst"
    ],
    "require_mcpm_twin": true
  },
  "profiles": {},
  "settings": {
    "ensure_allow": [
      "Bash(git diff:*)",
      "Read(*)",
      "WebFetch(domain:example.test)"
    ],
    "ensure_ask": [
      "Bash(git push:*)"
    ]
  },
  "wrap_default_claude": false
}
