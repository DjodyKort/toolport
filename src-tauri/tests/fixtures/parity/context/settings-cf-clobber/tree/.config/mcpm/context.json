{
  "cf_wrapper_hash": null,
  "clients_root": "<HOME>/clients",
  "dedupe": {
    "enabled": false,
    "legacy_names": [
      "context7",
      "playwright",
      "codeforward-odoo",
      "codeforward-typst"
    ],
    "require_mcpm_twin": true
  },
  "profiles": {},
  "settings": {
    "ensure_allow": [
      "Bash(git status:*)",
      "Bash(ls:*)",
      "mcp__mcpm_codeforward-odoo__search",
      "Read(*)"
    ],
    "ensure_ask": [
      "Bash(rm:*)",
      "Bash(git push:*)"
    ]
  },
  "wrap_default_claude": false
}
